# Frontend env template
# Vite exposes these values to the browser build.
VITE_API_BASE_URL=http://localhost:3000/api
VITE_APP_TITLE=BookingAI Admin Dashboard
VITE_ENV=development

# Backend runtime defaults for the phase-1 auth/session + phase-2 booking-data harness.
# The backend reads API_BASE_URL directly, while the frontend should keep
# VITE_API_BASE_URL pointed at the same /api prefix.
PORT=3000
API_BASE_URL=http://localhost:3000/api
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-me-in-development
SESSION_COOKIE_NAME=easy_assistant_session
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easy_assistant
